# Developer-only values. Copy this file to .env; never commit the result.
POSTGRES_DB=lumina_pos_dev
POSTGRES_USER=lumina_local_owner
POSTGRES_PASSWORD=replace-with-a-local-owner-password
POSTGRES_PORT=5432
MIGRATION_DATABASE_USER=lumina_local_migrator
MIGRATION_DATABASE_PASSWORD=replace-with-a-local-migration-password
RUNTIME_DATABASE_USER=lumina_local_runtime
RUNTIME_DATABASE_PASSWORD=replace-with-a-local-runtime-password
DATABASE_ADMIN_URL=postgresql://lumina_local_owner:replace-with-a-local-owner-password@localhost:5432/lumina_pos_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://lumina_local_migrator:replace-with-a-local-migration-password@localhost:5432/lumina_pos_dev?schema=public
DATABASE_URL=postgresql://lumina_local_runtime:replace-with-a-local-runtime-password@localhost:5432/lumina_pos_dev?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
SESSION_DIGEST_KEY=replace-with-32-random-bytes-encoded-as-base64
RATE_LIMIT_DIGEST_KEY=replace-with-a-different-32-byte-base64-key
# Forwarded client IP headers are ignored unless a reviewed deployment proxy is configured.
TRUST_PROXY_HEADERS=false

